# Copy to .env and adjust. Never commit the real .env.
ENV=local

# SQLite works out of the box. For Postgres (docker compose up db redis):
# DATABASE_URL=postgresql+psycopg://campusbite:campusbite@localhost:5432/campusbite
DATABASE_URL=sqlite:///./campusbite.db

# Optional. When set, realtime events fan out through Redis pub/sub.
# REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-to-a-long-random-string
WEBHOOK_SECRET=change-me-too

# Money in paise / basis points
TAX_BPS=500
PLATFORM_FEE_PAISE=0
COMMISSION_BPS=500

UNPAID_ORDER_EXPIRY_MINUTES=15
ACCEPT_TIMEOUT_MINUTES=10
PICKUP_CODE_TTL_MINUTES=30

# Set false on extra API replicas and run `python -m app.worker` once instead.
RUN_WORKER=true
CORS_ORIGINS=*
